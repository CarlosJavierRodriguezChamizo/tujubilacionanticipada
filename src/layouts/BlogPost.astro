---
import type { CollectionEntry } from 'astro:content';
import Base from './Base.astro';
import { formatDate, toISO, readingTimeMinutes, resolveHeroImage, getPublishedPosts } from '../lib/posts';
import {
  articleWebPageSchema,
  blogPostingSchema,
  breadcrumbSchema,
  REVIEWER_PROFILES,
} from '../lib/schema';
import { getCategorySlug } from '../lib/categories';
import { getCanonicalSlug } from '../lib/canonical-map';
import ShareButtons from '../components/ShareButtons.astro';
import RelatedArticles from '../components/RelatedArticles.astro';
import AsesoramientoCard from '../components/AsesoramientoCard.astro';
import { SITE, REVIEWERS } from '../consts';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { data } = post;
const path = `/blog/${post.slug}`;
const shareUrl = new URL(path, SITE.url).toString();
const minutos = readingTimeMinutes(post.body);
const heroImage = resolveHeroImage(post.slug, data.heroImage);
const reviewerImg = data.reviewedBy ? REVIEWERS[data.reviewedBy] : undefined;
const reviewerHref = data.reviewedBy ? REVIEWER_PROFILES[data.reviewedBy] : undefined;

// El eyebrow de categoría solo enlaza a su silo si esa categoría tiene
// página de silo generada (mismo umbral que en
// src/pages/blog/categoria/[categoria].astro: MIN_POSTS_PER_SILO = 3).
// Evita enlaces rotos a categorías sin suficientes artículos publicados.
const MIN_POSTS_PER_SILO = 3;
const allPosts = await getPublishedPosts();
const categoryPostCount = allPosts.filter((p) => p.data.category === data.category).length;
const categoryHref =
  categoryPostCount >= MIN_POSTS_PER_SILO
    ? `/blog/categoria/${getCategorySlug(data.category)}`
    : undefined;

// Consolidación de contenido canibalizado (seo-013/seo-014): si este artículo
// declara la misma keyword exacta que otro publicado antes, el canonical apunta
// a aquel en vez de a sí mismo. Nunca noindex: solo canonical.
const canonicalDestino = getCanonicalSlug(post.slug);
const canonicalPath = canonicalDestino ? `/blog/${canonicalDestino}` : undefined;

const articleSchema = blogPostingSchema(post);
const breadcrumb = breadcrumbSchema([
  { name: 'Inicio', path: '/' },
  { name: 'Blog', path: '/blog' },
  ...(categoryHref ? [{ name: data.category, path: categoryHref }] : []),
  { name: data.title, path },
]);
---

<Base
  title={data.seoTitle ?? data.title}
  description={data.description}
  path={path}
  canonicalPath={canonicalPath}
  image={data.ogImage ?? heroImage}
  ogType="article"
  schema={[articleSchema, ...articleWebPageSchema(post), breadcrumb]}
>
  <article class="container-prose py-10 sm:py-14">
    <nav aria-label="Migas de pan" class="mb-6 text-sm text-ink-muted">
      <a href="/" class="hover:text-brand-600">Inicio</a>
      <span class="px-1.5" aria-hidden="true">/</span>
      <a href="/blog" class="hover:text-brand-600">Blog</a>
      {
        categoryHref && (
          <>
            <span class="px-1.5" aria-hidden="true">/</span>
            <a href={categoryHref} class="hover:text-brand-600">
              {data.category}
            </a>
          </>
        )
      }
    </nav>

    <header class="mx-auto max-w-prose">
      {
        categoryHref ? (
          <p class="eyebrow">
            <a href={categoryHref} class="hover:underline underline-offset-4">
              {data.category}
            </a>
          </p>
        ) : (
          <p class="eyebrow">{data.category}</p>
        )
      }
      <h1 class="mt-3 text-3xl font-semibold leading-tight sm:text-4xl">
        {data.title}
      </h1>
      <p class="mt-4 text-lg text-ink-soft">{data.description}</p>
      <div class="mt-4 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-ink-muted">
        <span>{data.author}</span>
        <span aria-hidden="true">·</span>
        <time datetime={toISO(data.pubDate)}>{formatDate(data.pubDate)}</time>
        <span aria-hidden="true">·</span>
        <span>{minutos} min de lectura</span>
        {
          data.updatedDate && (
            <>
              <span aria-hidden="true">·</span>
              <span>Actualizado: {formatDate(data.updatedDate)}</span>
            </>
          )
        }
      </div>
    </header>

    {
      heroImage && (
        <figure class="mx-auto mt-8 max-w-3xl">
          <img
            src={heroImage}
            alt={data.heroImageAlt ?? data.title}
            width="1200"
            height="675"
            loading="eager"
            class="aspect-video w-full rounded-xl border border-paper-200 object-cover"
          />
        </figure>
      )
    }

    <ShareButtons url={shareUrl} title={data.title} />

    <hr class="mx-auto mt-8 max-w-prose border-paper-300" />

    <div class="prose prose-lg mx-auto mt-8 prose-a:font-medium">
      <slot />
    </div>

    {
      data.reviewedBy && (
        <aside class="mx-auto mt-12 flex max-w-prose items-center gap-4 rounded-xl border border-paper-200 bg-paper-100 p-5">
          {reviewerImg && (
            reviewerHref ? (
              <a href={reviewerHref} class="shrink-0">
                <img
                  src={reviewerImg}
                  alt={`Foto de ${data.reviewedBy}`}
                  width="64"
                  height="64"
                  loading="lazy"
                  class="h-16 w-16 rounded-full border border-paper-300 object-cover"
                />
              </a>
            ) : (
              <img
                src={reviewerImg}
                alt={`Foto de ${data.reviewedBy}`}
                width="64"
                height="64"
                loading="lazy"
                class="h-16 w-16 shrink-0 rounded-full border border-paper-300 object-cover"
              />
            )
          )}
          <div>
            <p class="text-xs font-semibold uppercase tracking-wide text-clay-700">
              Revisado por
            </p>
            <p class="font-serif text-base font-semibold text-ink">
              {reviewerHref ? (
                <a href={reviewerHref} class="underline underline-offset-4 hover:text-clay-700">
                  {data.reviewedBy}
                </a>
              ) : (
                data.reviewedBy
              )}
            </p>
            {data.reviewerTitle && (
              <p class="mt-0.5 text-sm text-ink-soft">{data.reviewerTitle}</p>
            )}
          </div>
        </aside>
      )
    }

    <div class="mx-auto mt-10 max-w-prose border-t border-paper-300 pt-6">
      <a href="/blog" class="text-sm font-semibold text-clay-700 hover:text-clay-800">
        ← Volver al blog
      </a>
    </div>
  </article>

  <RelatedArticles post={post} />

  <AsesoramientoCard />
</Base>
