---
import Base from '../../layouts/Base.astro';
import BlogListing from '../../components/BlogListing.astro';
// Guía oculta temporalmente: import CTAGuia from '../../components/CTAGuia.astro';
import { getPublishedPosts } from '../../lib/posts';
import { POSTS_PER_PAGE } from '../../consts';
import { getCategorySlug } from '../../lib/categories';
import { BLOG_CATEGORIES } from '../../content/config';
import {
  blogCollectionSchema,
  breadcrumbSchema,
  webPageSchema,
} from '../../lib/schema';

const allPosts = await getPublishedPosts();
const posts = allPosts.slice(0, POSTS_PER_PAGE);
const lastPage = Math.max(1, Math.ceil(allPosts.length / POSTS_PER_PAGE));

// Mismo umbral que src/pages/blog/categoria/[categoria].astro: solo se
// enlazan los silos que tienen página de categoría generada (evita enlaces
// rotos a silos sin suficiente contenido).
const MIN_POSTS_PER_SILO = 3;
const publishedSilos = BLOG_CATEGORIES.filter((category) => {
  const count = allPosts.filter((post) => post.data.category === category).length;
  return count >= MIN_POSTS_PER_SILO;
});

const descripcion =
  'Artículos sobre jubilación anticipada en España: requisitos, penalizaciones, cálculo de la pensión y guías prácticas para planificar tu retiro.';

const schema = [
  blogCollectionSchema(allPosts),
  breadcrumbSchema([
    { name: 'Inicio', path: '/' },
    { name: 'Blog', path: '/blog' },
  ]),
  webPageSchema({
    type: 'CollectionPage',
    path: '/blog',
    name: 'Blog sobre jubilación anticipada',
    description: descripcion,
    breadcrumbPath: '/blog',
  }),
];
---

<Base
  title="Blog sobre jubilación anticipada"
  description={descripcion}
  path="/blog"
  schema={schema}
>
  <section class="container-prose py-12 sm:py-16">
    <header class="max-w-3xl">
      <p class="eyebrow">Blog</p>
      <h1 class="mt-3 text-4xl font-semibold sm:text-5xl">
        Jubilación anticipada, sin letra pequeña
      </h1>
      <p class="mt-4 text-lg text-ink-soft">
        Guías y análisis para entender tu pensión y tomar mejores decisiones
        sobre cuándo jubilarte.
      </p>
    </header>

    {
      publishedSilos.length > 0 && (
        <nav aria-label="Categorías del blog" class="mt-10">
          <p class="eyebrow">Explora por categoría</p>
          <ul class="mt-3 flex flex-wrap gap-3">
            {publishedSilos.map((category) => (
              <li>
                <a
                  href={`/blog/categoria/${getCategorySlug(category)}`}
                  class="inline-block rounded-full border border-clay-200 px-4 py-2 text-sm font-medium text-clay-800 hover:border-clay-400 hover:text-clay-950"
                >
                  {category}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }

    <div class="mt-10">
      {
        posts.length > 0 ? (
          <BlogListing posts={posts} currentPage={1} lastPage={lastPage} />
        ) : (
          <p class="text-ink-muted">Todavía no hay artículos publicados.</p>
        )
      }
    </div>
  </section>

  {/* Guía oculta temporalmente hasta que el producto esté definido.
  <CTAGuia variant="banner" />
  */}
</Base>
