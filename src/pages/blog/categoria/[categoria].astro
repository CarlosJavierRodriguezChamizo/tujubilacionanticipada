---
import type { GetStaticPaths } from 'astro';
import Base from '../../../layouts/Base.astro';
import BlogListing from '../../../components/BlogListing.astro';
import { getPublishedPosts } from '../../../lib/posts';
import { getCategorySlug, MIN_POSTS_PER_SILO } from '../../../lib/categories';
import { BLOG_CATEGORIES } from '../../../content/config';
import { breadcrumbSchema, webPageSchema } from '../../../lib/schema';

// Descripciones específicas por categoría (evitan duplicar el meta description
// genérico del blog y refuerzan la temática del silo para SEO).
const CATEGORY_DESCRIPTIONS: Record<(typeof BLOG_CATEGORIES)[number], string> = {
  'Tipos de jubilación anticipada':
    'Todos los tipos de jubilación anticipada en España: voluntaria, involuntaria, para autónomos, funcionarios, profesiones de riesgo y más.',
  'Cálculos y penalizaciones':
    'Cómo se calcula tu pensión de jubilación anticipada: base reguladora, coeficientes reductores, penalizaciones y años cotizados.',
  'Planificación financiera':
    'Planifica tu jubilación anticipada: planes de pensiones, fondos indexados y estrategias para cubrir el gap económico hasta la jubilación ordinaria.',
  'Actualidad y casos prácticos':
    'Novedades normativas y casos prácticos sobre jubilación anticipada en España.',
};

export const getStaticPaths = (async () => {
  const allPosts = await getPublishedPosts();

  // Umbral mínimo de artículos publicados para que una categoría tenga su
  // propia página de silo (evita silos "vacíos" o casi vacíos). Se importa
  // desde src/lib/categories.ts para que sea el mismo valor que usa el
  // eyebrow de categoría de BlogPost.astro al decidir si enlaza al silo.
  return BLOG_CATEGORIES.filter((category) => {
    const count = allPosts.filter((post) => post.data.category === category).length;
    return count >= MIN_POSTS_PER_SILO;
  }).map((category) => {
    const posts = allPosts.filter((post) => post.data.category === category);
    return {
      params: { categoria: getCategorySlug(category) },
      props: { category, posts },
    };
  });
}) satisfies GetStaticPaths;

const { category, posts } = Astro.props;
const slug = getCategorySlug(category);
const path = `/blog/categoria/${slug}`;
const descripcion = CATEGORY_DESCRIPTIONS[category];

const schema = [
  breadcrumbSchema([
    { name: 'Inicio', path: '/' },
    { name: 'Blog', path: '/blog' },
    { name: category, path },
  ]),
  webPageSchema({
    type: 'CollectionPage',
    path,
    name: `${category} · Blog`,
    description: descripcion,
    breadcrumbPath: path,
  }),
];
---

<Base
  title={category}
  description={descripcion}
  path={path}
  schema={schema}
>
  <section class="container-prose py-12 sm:py-16">
    <nav aria-label="Migas de pan" class="text-sm text-ink-muted">
      <a href="/" class="hover:text-clay-700">Inicio</a>
      <span aria-hidden="true"> / </span>
      <a href="/blog" class="hover:text-clay-700">Blog</a>
      <span aria-hidden="true"> / </span>
      <span aria-current="page">{category}</span>
    </nav>

    <header class="mt-4 max-w-3xl">
      <p class="eyebrow">Categoría del blog</p>
      <h1 class="mt-3 text-4xl font-semibold sm:text-5xl">{category}</h1>
      <p class="mt-4 text-lg text-ink-soft">{descripcion}</p>
    </header>

    <div class="mt-10">
      <BlogListing posts={posts} currentPage={1} lastPage={1} />
    </div>
  </section>
</Base>
