---
import Base from '../layouts/Base.astro';
import Simulador from '../components/Simulador.jsx';
import { DISCLAIMER } from '../consts';
import {
  faqSchema,
  breadcrumbSchema,
  webApplicationSchema,
  webPageSchema,
} from '../lib/schema';
import {
  COEF_VOLUNTARIA,
  COEF_INVOLUNTARIA,
  ETIQUETAS_TRAMOS,
  EDAD_LEGAL_REDUCIDA,
  ANTICIPO_VOLUNTARIA_MESES,
  ANTICIPO_FORZOSA_MESES,
  ANTICIPO_VOLUNTARIA_ANIOS,
  ANTICIPO_FORZOSA_ANIOS,
  REQ_COTIZACION_VOLUNTARIA,
  REQ_COTIZACION_FORZOSA,
  edadLegalJubilacion,
  calcularEscenario,
  type EscenarioResultado,
} from '../lib/pension-calculo';

const BOE_LGSS = 'https://www.boe.es/buscar/act.php?id=BOE-A-2015-11724';
const BOE_RD241_2026 = 'https://www.boe.es/diario_boe/txt.php?id=BOE-A-2026-6977';

/** Formatea el % de reducción con 2 decimales fijos, sin alterar el valor. */
const formatoPorcentaje = (valor: number) =>
  valor.toLocaleString('es-ES', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

const filasVoluntaria = Object.entries(COEF_VOLUNTARIA)
  .map(([meses, tramos]) => ({ meses: Number(meses), tramos }))
  .sort((a, b) => a.meses - b.meses);

const filasInvoluntaria = Object.entries(COEF_INVOLUNTARIA)
  .map(([meses, tramos]) => ({ meses: Number(meses), tramos }))
  .sort((a, b) => a.meses - b.meses);

/* ─────────── Tabla estática de escenarios precalculados (seo-019) ───────────
 * Genera en build (sin JavaScript) una tabla de ejemplos combinando edad
 * actual x años cotizados x base reguladora, usando el mismo motor de
 * cálculo (src/lib/pension-calculo.ts, normativa 2026) que la calculadora
 * interactiva. Es contenido de ejemplo, no un dato del usuario: sirve para
 * que la página tenga una estimación legible sin JS, y la isla React de
 * abajo añade el cálculo personalizado como mejora progresiva.
 *
 * Combinaciones filtradas a edad-cotizados plausibles (edad mínima legal de
 * incorporación al mercado laboral: 16 años) para no mostrar ejemplos
 * imposibles.
 */
const EDADES_EJEMPLO = [45, 50, 55, 58, 60, 63] as const;
const ANIOS_COTIZADOS_EJEMPLO = [20, 25, 30, 35, 40] as const;
const BASES_EJEMPLO = [1400, 2200, 3200] as const;
const EDAD_MINIMA_INICIO_COTIZACION = 16;

interface FilaEjemplo {
  edadActual: number;
  aniosCotizados: number;
  baseReguladora: number;
  edadLegal: number;
  ordinaria: EscenarioResultado;
  voluntaria: EscenarioResultado;
  forzosa: EscenarioResultado;
}

const escenariosEjemplo: FilaEjemplo[] = [];
for (const edadActual of EDADES_EJEMPLO) {
  for (const aniosCotizados of ANIOS_COTIZADOS_EJEMPLO) {
    if (aniosCotizados > edadActual - EDAD_MINIMA_INICIO_COTIZACION) continue;
    for (const baseReguladora of BASES_EJEMPLO) {
      const cotizadosA65 =
        aniosCotizados + Math.max(0, EDAD_LEGAL_REDUCIDA - edadActual);
      const edadLegal = edadLegalJubilacion(cotizadosA65);
      const base = { edadActual, aniosCotizadosActuales: aniosCotizados, baseReguladora };

      const ordinaria = calcularEscenario({
        ...base,
        edadJubilacion: edadLegal,
        mesesAnticipo: 0,
        modalidad: 'ordinaria',
        requisitoCotizacion: null,
      });
      const voluntaria = calcularEscenario({
        ...base,
        edadJubilacion: edadLegal - ANTICIPO_VOLUNTARIA_ANIOS,
        mesesAnticipo: ANTICIPO_VOLUNTARIA_MESES,
        modalidad: 'voluntaria',
        requisitoCotizacion: REQ_COTIZACION_VOLUNTARIA,
      });
      const forzosa = calcularEscenario({
        ...base,
        edadJubilacion: edadLegal - ANTICIPO_FORZOSA_ANIOS,
        mesesAnticipo: ANTICIPO_FORZOSA_MESES,
        modalidad: 'involuntaria',
        requisitoCotizacion: REQ_COTIZACION_FORZOSA,
      });

      escenariosEjemplo.push({
        edadActual,
        aniosCotizados,
        baseReguladora,
        edadLegal,
        ordinaria,
        voluntaria,
        forzosa,
      });
    }
  }
}

const euroTabla = (valor: number) =>
  valor.toLocaleString('es-ES', {
    style: 'currency',
    currency: 'EUR',
    maximumFractionDigits: 0,
  });

/** Celda de pensión: honesta sobre los casos que no alcanzan requisitos. */
const celdaPension = (esc: EscenarioResultado) => {
  if (!esc.cumplePensionMinima) return 'No llega a los 15 años mínimos';
  if (!esc.cumpleRequisito) return `${euroTabla(esc.pensionFinal)} (posible falta de requisito)`;
  return euroTabla(esc.pensionFinal);
};

const path = '/simulador';
const descripcion =
  'Calcula gratis tu pensión estimada y las fechas posibles de jubilación ordinaria, anticipada voluntaria y forzosa en España.';

const faqs = [
  {
    q: '¿Cuánto se penaliza la jubilación anticipada voluntaria?',
    a: 'Desde 2022 la reducción es mensual y depende de los años cotizados (art. 208.2 LGSS). Adelantando los 24 meses máximos, la pensión se reduce un 21 % con menos de 38 años y 6 meses cotizados y un 13 % con 44 años y 6 meses o más. Adelantando un solo mes, entre el 3,26 % y el 2,81 %.',
  },
  {
    q: '¿Cuánto se penaliza la jubilación anticipada forzosa?',
    a: 'La forzosa (ERE, despido objetivo u otra causa no imputable al trabajador) permite adelantar hasta 48 meses y su reducción también es mensual y por tramos de cotización (art. 207.2 LGSS): entre el 30 % y el 24 % con los 48 meses completos, y entre el 0,63 % y el 0,50 % con un solo mes.',
  },
  {
    q: '¿Qué es la base reguladora?',
    a: 'Es el promedio de tus bases de cotización y sirve para calcular el importe de la pensión. Desde el 1 de enero de 2026 se obtiene dividiendo entre 352,33 las 302 bases más altas de los últimos 304 meses (DT 40.ª LGSS).',
  },
];

const schema = [
  webApplicationSchema({
    name: 'Calcula tu jubilación anticipada: simulador gratuito',
    description: descripcion,
    path,
    // seo-019: la página ya renderiza en build una tabla estática de
    // escenarios precalculados (sin JavaScript) equivalente en contenido a
    // la isla React, que ahora es una mejora progresiva sobre esa tabla.
    requiresJs: false,
  }),
  faqSchema(faqs),
  breadcrumbSchema([
    { name: 'Inicio', path: '/' },
    { name: 'Simulador', path },
  ]),
  webPageSchema({
    path,
    name: 'Calcula tu jubilación anticipada: simulador gratuito',
    description: descripcion,
    breadcrumbPath: path,
  }),
];
---

<Base
  title="Calcula tu jubilación anticipada: simulador gratuito"
  description={descripcion}
  path={path}
  schema={schema}
>
  <section class="container-prose py-12 sm:py-16">
    <div class="max-w-3xl">
      <p class="eyebrow">Simulador gratuito</p>
      <h1 class="mt-3 text-4xl font-semibold sm:text-5xl">
        Calcula tu jubilación anticipada
      </h1>
      <p class="mt-4 text-lg text-ink-soft">
        Estima tu pensión y descubre cuándo podrías jubilarte. Compara la
        jubilación ordinaria con la anticipada voluntaria y la forzosa, con la
        penalización aplicada en cada caso.
      </p>
    </div>

    <div
      role="note"
      class="mt-8 max-w-3xl rounded-xl border border-amber-200 bg-amber-50 p-4 text-sm leading-relaxed text-amber-900"
    >
      <strong class="font-semibold">Aviso:</strong> {DISCLAIMER}
    </div>

    <div class="mt-12">
      <h2 class="text-2xl font-semibold">
        Ejemplos de pensión estimada por edad, años cotizados y base reguladora
      </h2>
      <p class="mt-2 max-w-3xl text-ink-soft">
        Estos {escenariosEjemplo.length} ejemplos, calculados con la misma
        fórmula que la calculadora interactiva de abajo, muestran la pensión
        mensual estimada en la jubilación ordinaria y en la anticipada
        (voluntaria y forzosa) para distintas combinaciones de edad actual,
        años cotizados y base reguladora. Son casos ilustrativos, no tu
        cálculo personal: usa la calculadora para introducir tus propios
        datos. Cifras según el
        {' '}<a href={BOE_LGSS} class="underline" target="_blank" rel="noopener">
          artículo 210.1 de la Ley General de la Seguridad Social
        </a> (porcentaje sobre base reguladora) y el
        {' '}<a href={BOE_RD241_2026} class="underline" target="_blank" rel="noopener">
          Real Decreto 241/2026
        </a> (límites de pensión máxima y mínima para 2026).
      </p>
      <div class="mt-4 overflow-x-auto">
        <table class="w-full text-sm">
          <caption class="sr-only">
            Ejemplos de pensión mensual estimada por edad actual, años
            cotizados y base reguladora, en jubilación ordinaria, anticipada
            voluntaria y anticipada forzosa
          </caption>
          <thead>
            <tr class="border-b border-paper-200 text-left">
              <th scope="col" class="py-2 pr-4 font-semibold">Edad actual</th>
              <th scope="col" class="py-2 pr-4 font-semibold">Años cotizados</th>
              <th scope="col" class="py-2 pr-4 font-semibold">Base reguladora</th>
              <th scope="col" class="py-2 pr-4 font-semibold">Edad legal</th>
              <th scope="col" class="py-2 pr-4 font-semibold">Pensión ordinaria</th>
              <th scope="col" class="py-2 pr-4 font-semibold">Anticipada voluntaria</th>
              <th scope="col" class="py-2 pr-4 font-semibold">Anticipada forzosa</th>
            </tr>
          </thead>
          <tbody>
            {
              escenariosEjemplo.map((fila) => (
                <tr class="border-b border-paper-200/60">
                  <th scope="row" class="py-1.5 pr-4 text-left font-normal">
                    {fila.edadActual} años
                  </th>
                  <td class="py-1.5 pr-4 tabular-nums">{fila.aniosCotizados} años</td>
                  <td class="py-1.5 pr-4 tabular-nums">{euroTabla(fila.baseReguladora)}/mes</td>
                  <td class="py-1.5 pr-4 tabular-nums">
                    {fila.edadLegal.toLocaleString('es-ES', { maximumFractionDigits: 2 })} años
                  </td>
                  <td class="py-1.5 pr-4 tabular-nums">{celdaPension(fila.ordinaria)}</td>
                  <td class="py-1.5 pr-4 tabular-nums">{celdaPension(fila.voluntaria)}</td>
                  <td class="py-1.5 pr-4 tabular-nums">{celdaPension(fila.forzosa)}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>

    <div class="mt-16">
      <h2 class="text-2xl font-semibold">Calcula tu caso personal</h2>
      <p class="mt-2 max-w-3xl text-ink-soft">
        Introduce tus datos para obtener una estimación adaptada a tu
        situación, con las mismas fórmulas que los ejemplos anteriores.
      </p>
      <div class="mt-6">
        <Simulador client:load disclaimer={DISCLAIMER} />
      </div>
    </div>

    <div class="mt-16">
      <h2 class="text-2xl font-semibold">
        Tabla de coeficientes reductores: jubilación anticipada voluntaria
      </h2>
      <p class="mt-2 max-w-3xl text-ink-soft">
        Porcentaje total de reducción de la pensión según los meses de
        anticipación respecto a tu edad ordinaria de jubilación y los años
        cotizados acreditados, conforme al
        <a
          href={BOE_LGSS}
          class="underline"
          target="_blank"
          rel="noopener"
        >
          artículo 208.2 de la Ley General de la Seguridad Social
        </a>.
      </p>
      <div class="mt-4 overflow-x-auto">
        <table class="w-full text-sm">
          <caption class="sr-only">
            Coeficientes reductores de la jubilación anticipada voluntaria
            por meses de anticipación y tramo de cotización (art. 208.2 LGSS)
          </caption>
          <thead>
            <tr class="border-b border-paper-200 text-left">
              <th scope="col" class="py-2 pr-4 font-semibold">
                Meses de anticipación
              </th>
              {
                ETIQUETAS_TRAMOS.map((etiqueta) => (
                  <th scope="col" class="py-2 pr-4 font-semibold">
                    {etiqueta}
                  </th>
                ))
              }
            </tr>
          </thead>
          <tbody>
            {
              filasVoluntaria.map(({ meses, tramos }) => (
                <tr class="border-b border-paper-200/60">
                  <th scope="row" class="py-1.5 pr-4 text-left font-normal">
                    {meses} {meses === 1 ? 'mes' : 'meses'}
                  </th>
                  {
                    tramos.map((valor) => (
                      <td class="py-1.5 pr-4 tabular-nums">
                        {formatoPorcentaje(valor)} %
                      </td>
                    ))
                  }
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>

    <div class="mt-16">
      <h2 class="text-2xl font-semibold">
        Tabla de coeficientes reductores: jubilación anticipada involuntaria
      </h2>
      <p class="mt-2 max-w-3xl text-ink-soft">
        Porcentaje total de reducción de la pensión aplicable cuando el cese
        en el trabajo se debe a una causa no imputable a la persona
        trabajadora (ERE, despido objetivo u otras), conforme al
        <a
          href={BOE_LGSS}
          class="underline"
          target="_blank"
          rel="noopener"
        >
          artículo 207.2 de la Ley General de la Seguridad Social
        </a>.
      </p>
      <div class="mt-4 overflow-x-auto">
        <table class="w-full text-sm">
          <caption class="sr-only">
            Coeficientes reductores de la jubilación anticipada involuntaria
            por meses de anticipación y tramo de cotización (art. 207.2 LGSS)
          </caption>
          <thead>
            <tr class="border-b border-paper-200 text-left">
              <th scope="col" class="py-2 pr-4 font-semibold">
                Meses de anticipación
              </th>
              {
                ETIQUETAS_TRAMOS.map((etiqueta) => (
                  <th scope="col" class="py-2 pr-4 font-semibold">
                    {etiqueta}
                  </th>
                ))
              }
            </tr>
          </thead>
          <tbody>
            {
              filasInvoluntaria.map(({ meses, tramos }) => (
                <tr class="border-b border-paper-200/60">
                  <th scope="row" class="py-1.5 pr-4 text-left font-normal">
                    {meses} {meses === 1 ? 'mes' : 'meses'}
                  </th>
                  {
                    tramos.map((valor) => (
                      <td class="py-1.5 pr-4 tabular-nums">
                        {formatoPorcentaje(valor)} %
                      </td>
                    ))
                  }
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>

    <div class="mt-12 max-w-3xl">
      <h2 class="text-2xl font-semibold">Preguntas frecuentes</h2>
      <dl class="mt-6 space-y-6">
        {
          faqs.map((faq) => (
            <div>
              <dt class="font-semibold">{faq.q}</dt>
              <dd class="mt-1 text-ink-soft">{faq.a}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>
</Base>
