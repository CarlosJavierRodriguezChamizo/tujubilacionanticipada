---
import Base from '../layouts/Base.astro';
import Simulador from '../components/Simulador.jsx';
import { DISCLAIMER } from '../consts';
import {
  faqSchema,
  breadcrumbSchema,
  webApplicationSchema,
  webPageSchema,
} from '../lib/schema';
import { COEF_VOLUNTARIA, COEF_INVOLUNTARIA, ETIQUETAS_TRAMOS } from '../lib/pension-calculo';

const BOE_LGSS = 'https://www.boe.es/buscar/act.php?id=BOE-A-2015-11724';

/** Formatea el % de reducción con 2 decimales fijos, sin alterar el valor. */
const formatoPorcentaje = (valor: number) =>
  valor.toLocaleString('es-ES', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

const filasVoluntaria = Object.entries(COEF_VOLUNTARIA)
  .map(([meses, tramos]) => ({ meses: Number(meses), tramos }))
  .sort((a, b) => a.meses - b.meses);

const filasInvoluntaria = Object.entries(COEF_INVOLUNTARIA)
  .map(([meses, tramos]) => ({ meses: Number(meses), tramos }))
  .sort((a, b) => a.meses - b.meses);

const path = '/simulador';
const descripcion =
  'Calcula gratis tu pensión estimada y las fechas posibles de jubilación ordinaria, anticipada voluntaria y forzosa en España.';

const faqs = [
  {
    q: '¿Cuánto se penaliza la jubilación anticipada voluntaria?',
    a: 'Desde 2022 la reducción es mensual y depende de los años cotizados (art. 208.2 LGSS). Adelantando los 24 meses máximos, la pensión se reduce un 21 % con menos de 38 años y 6 meses cotizados y un 13 % con 44 años y 6 meses o más. Adelantando un solo mes, entre el 3,26 % y el 2,81 %.',
  },
  {
    q: '¿Cuánto se penaliza la jubilación anticipada forzosa?',
    a: 'La forzosa (ERE, despido objetivo u otra causa no imputable al trabajador) permite adelantar hasta 48 meses y su reducción también es mensual y por tramos de cotización (art. 207.2 LGSS): entre el 30 % y el 24 % con los 48 meses completos, y entre el 0,63 % y el 0,50 % con un solo mes.',
  },
  {
    q: '¿Qué es la base reguladora?',
    a: 'Es el promedio de tus bases de cotización y sirve para calcular el importe de la pensión. Desde el 1 de enero de 2026 se obtiene dividiendo entre 352,33 las 302 bases más altas de los últimos 304 meses (DT 40.ª LGSS).',
  },
];

const schema = [
  webApplicationSchema({
    name: 'Calcula tu jubilación anticipada: simulador gratuito',
    description: descripcion,
    path,
    // requiresJs se mantiene en true (valor por defecto) porque hoy la
    // calculadora sigue siendo una isla React sin tabla estática
    // equivalente (seo-019/seo-020 quedaron pendientes por precaución
    // normativa): sin JavaScript el formulario no calcula nada. Cuando
    // exista esa alternativa estática, este valor debe pasar a false.
    requiresJs: true,
  }),
  faqSchema(faqs),
  breadcrumbSchema([
    { name: 'Inicio', path: '/' },
    { name: 'Simulador', path },
  ]),
  webPageSchema({
    path,
    name: 'Calcula tu jubilación anticipada: simulador gratuito',
    description: descripcion,
    breadcrumbPath: path,
  }),
];
---

<Base
  title="Calcula tu jubilación anticipada: simulador gratuito"
  description={descripcion}
  path={path}
  schema={schema}
>
  <section class="container-prose py-12 sm:py-16">
    <div class="max-w-3xl">
      <p class="eyebrow">Simulador gratuito</p>
      <h1 class="mt-3 text-4xl font-semibold sm:text-5xl">
        Calcula tu jubilación anticipada
      </h1>
      <p class="mt-4 text-lg text-ink-soft">
        Estima tu pensión y descubre cuándo podrías jubilarte. Compara la
        jubilación ordinaria con la anticipada voluntaria y la forzosa, con la
        penalización aplicada en cada caso.
      </p>
    </div>

    <div class="mt-10">
      <Simulador client:load disclaimer={DISCLAIMER} />
    </div>

    <div class="mt-16">
      <h2 class="text-2xl font-semibold">
        Tabla de coeficientes reductores: jubilación anticipada voluntaria
      </h2>
      <p class="mt-2 max-w-3xl text-ink-soft">
        Porcentaje total de reducción de la pensión según los meses de
        anticipación respecto a tu edad ordinaria de jubilación y los años
        cotizados acreditados, conforme al
        <a
          href={BOE_LGSS}
          class="underline"
          target="_blank"
          rel="noopener"
        >
          artículo 208.2 de la Ley General de la Seguridad Social
        </a>.
      </p>
      <div class="mt-4 overflow-x-auto">
        <table class="w-full text-sm">
          <caption class="sr-only">
            Coeficientes reductores de la jubilación anticipada voluntaria
            por meses de anticipación y tramo de cotización (art. 208.2 LGSS)
          </caption>
          <thead>
            <tr class="border-b border-paper-200 text-left">
              <th scope="col" class="py-2 pr-4 font-semibold">
                Meses de anticipación
              </th>
              {
                ETIQUETAS_TRAMOS.map((etiqueta) => (
                  <th scope="col" class="py-2 pr-4 font-semibold">
                    {etiqueta}
                  </th>
                ))
              }
            </tr>
          </thead>
          <tbody>
            {
              filasVoluntaria.map(({ meses, tramos }) => (
                <tr class="border-b border-paper-200/60">
                  <th scope="row" class="py-1.5 pr-4 text-left font-normal">
                    {meses} {meses === 1 ? 'mes' : 'meses'}
                  </th>
                  {
                    tramos.map((valor) => (
                      <td class="py-1.5 pr-4 tabular-nums">
                        {formatoPorcentaje(valor)} %
                      </td>
                    ))
                  }
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>

    <div class="mt-16">
      <h2 class="text-2xl font-semibold">
        Tabla de coeficientes reductores: jubilación anticipada involuntaria
      </h2>
      <p class="mt-2 max-w-3xl text-ink-soft">
        Porcentaje total de reducción de la pensión aplicable cuando el cese
        en el trabajo se debe a una causa no imputable a la persona
        trabajadora (ERE, despido objetivo u otras), conforme al
        <a
          href={BOE_LGSS}
          class="underline"
          target="_blank"
          rel="noopener"
        >
          artículo 207.2 de la Ley General de la Seguridad Social
        </a>.
      </p>
      <div class="mt-4 overflow-x-auto">
        <table class="w-full text-sm">
          <caption class="sr-only">
            Coeficientes reductores de la jubilación anticipada involuntaria
            por meses de anticipación y tramo de cotización (art. 207.2 LGSS)
          </caption>
          <thead>
            <tr class="border-b border-paper-200 text-left">
              <th scope="col" class="py-2 pr-4 font-semibold">
                Meses de anticipación
              </th>
              {
                ETIQUETAS_TRAMOS.map((etiqueta) => (
                  <th scope="col" class="py-2 pr-4 font-semibold">
                    {etiqueta}
                  </th>
                ))
              }
            </tr>
          </thead>
          <tbody>
            {
              filasInvoluntaria.map(({ meses, tramos }) => (
                <tr class="border-b border-paper-200/60">
                  <th scope="row" class="py-1.5 pr-4 text-left font-normal">
                    {meses} {meses === 1 ? 'mes' : 'meses'}
                  </th>
                  {
                    tramos.map((valor) => (
                      <td class="py-1.5 pr-4 tabular-nums">
                        {formatoPorcentaje(valor)} %
                      </td>
                    ))
                  }
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>

    <div class="mt-12 max-w-3xl">
      <h2 class="text-2xl font-semibold">Preguntas frecuentes</h2>
      <dl class="mt-6 space-y-6">
        {
          faqs.map((faq) => (
            <div>
              <dt class="font-semibold">{faq.q}</dt>
              <dd class="mt-1 text-ink-soft">{faq.a}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>
</Base>
