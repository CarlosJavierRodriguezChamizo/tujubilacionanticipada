---
import type { CollectionEntry } from 'astro:content';
import { formatDate, toISO, readingTimeMinutes, resolveHeroImage } from '../lib/posts';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { data } = post;
const minutos = readingTimeMinutes(post.body);
const heroImage = resolveHeroImage(post.slug, data.heroImage);

// El enlace de la imagen va con aria-hidden y tabindex -1 a propósito: el
// titular de debajo ya enlaza al mismo sitio y no queremos anunciarlo dos
// veces. Aun así el `alt` describe el artículo de destino, porque lo leen
// Google Images y los rastreadores SEO, no solo los lectores de pantalla.
---

<article class="group relative flex h-full flex-col overflow-hidden rounded-xl border border-paper-200 bg-paper-50 transition-shadow hover:shadow-card">
  {
    heroImage && (
      <a href={`/blog/${post.slug}`} class="block" tabindex="-1" aria-hidden="true">
        <img
          src={heroImage}
          alt={data.heroImageAlt ?? data.title}
          width="1200"
          height="675"
          loading="lazy"
          class="aspect-video w-full border-b border-paper-200 object-cover"
        />
      </a>
    )
  }
  <div class="flex flex-1 flex-col p-6">
  <div class="flex items-center gap-2 text-xs text-ink-muted">
    <time datetime={toISO(data.pubDate)}>{formatDate(data.pubDate)}</time>
    <span aria-hidden="true">·</span>
    <span>{minutos} min de lectura</span>
  </div>

  <h3 class="mt-3 font-serif text-lg font-semibold leading-snug">
    <a
      href={`/blog/${post.slug}`}
      class="text-ink no-underline after:absolute after:inset-0 hover:text-clay-700"
    >
      {data.title}
    </a>
  </h3>

  <p class="mt-2 flex-1 text-sm leading-relaxed text-ink-soft">
    {data.description}
  </p>

  <span class="mt-4 text-sm font-semibold text-clay-700 group-hover:text-clay-800">
    Leer artículo →
  </span>
  </div>
</article>
