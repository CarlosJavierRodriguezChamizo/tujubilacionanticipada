---
import type { CollectionEntry } from 'astro:content';
import ArticleCard from './ArticleCard.astro';
import { getPublishedPosts } from '../lib/posts';
import { pickBalancedTargets, rotateByHash } from '../lib/rehype-plugins.mjs';

interface Props {
  post: CollectionEntry<'blog'>;
  max?: number;
}

const { post, max = 3 } = Astro.props;
const all = await getPublishedPosts();

// Prioriza misma categoría; completa con el resto si faltan. Dentro de la
// categoría, la selección usa pickBalancedTargets (compartido con
// rehypeInlineBlocks): un punto de partida determinista por artículo
// (hash del slug) que además garantiza un reparto homogéneo de enlaces
// entrantes, en vez de que todos los artículos sin suficientes compañeros
// de categoría caigan siempre en los mismos "más recientes por fecha".
const sameCategory = all.filter((p) => p.data.category === post.data.category);
const picks = pickBalancedTargets(sameCategory, post.slug, max, 'related');

let related = picks;
if (related.length < max) {
  const seen = new Set([...related.map((p) => p.slug), post.slug]);
  const rest = all.filter((p) => !seen.has(p.slug));
  related = [
    ...related,
    ...rotateByHash(rest, post.slug + 'related').slice(0, max - related.length),
  ];
}
---

{
  related.length > 0 && (
    <section class="border-t border-paper-300 bg-paper-100">
      <div class="container-prose py-14">
        <h2 class="text-2xl font-semibold sm:text-3xl">Artículos relacionados</h2>
        <p class="mt-2 text-ink-soft">
          Sigue profundizando en tu jubilación anticipada.
        </p>
        <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {related.map((p) => (
            <ArticleCard post={p} />
          ))}
        </div>
      </div>
    </section>
  )
}
