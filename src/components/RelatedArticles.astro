---
import type { CollectionEntry } from 'astro:content';
import ArticleCard from './ArticleCard.astro';
import { getPublishedPosts } from '../lib/posts';

interface Props {
  post: CollectionEntry<'blog'>;
  max?: number;
}

const { post, max = 3 } = Astro.props;
const all = await getPublishedPosts();
const others = all.filter((p) => p.slug !== post.slug);

// Hash determinista (djb2-like) del slug: da un punto de partida propio por
// artículo en vez de tomar siempre los mismos "más recientes" de la
// categoría (que antes concentraban casi todos los entrantes en 1-2 posts
// por categoría al usar siempre el índice 0 del listado ordenado por fecha).
function hashSlug(slug: string): number {
  let h = 5381;
  for (let i = 0; i < slug.length; i++) {
    h = (h * 33 + slug.charCodeAt(i)) >>> 0;
  }
  return h;
}
function rotated<T>(arr: T[], offset: number): T[] {
  if (arr.length === 0) return [];
  const start = offset % arr.length;
  return [...arr.slice(start), ...arr.slice(0, start)];
}

// Prioriza misma categoría (rotada por slug); completa con el resto (también
// rotado) si faltan candidatos.
const offset = hashSlug(post.slug);
const sameCategory = others.filter(
  (p) => p.data.category === post.data.category
);
const rest = others.filter((p) => p.data.category !== post.data.category);
const related = [...rotated(sameCategory, offset), ...rotated(rest, offset)].slice(
  0,
  max
);
---

{
  related.length > 0 && (
    <section class="border-t border-paper-300 bg-paper-100">
      <div class="container-prose py-14">
        <h2 class="text-2xl font-semibold sm:text-3xl">Artículos relacionados</h2>
        <p class="mt-2 text-ink-soft">
          Sigue profundizando en tu jubilación anticipada.
        </p>
        <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {related.map((p) => (
            <ArticleCard post={p} />
          ))}
        </div>
      </div>
    </section>
  )
}
