---
import { SITE, GA_MEASUREMENT_ID, COOKIE_CONSENT } from '../consts';

interface Props {
  title: string;
  description: string;
  /** Ruta de la página (ej. "/blog"). Se usa para el canonical. */
  path?: string;
  /**
   * Ruta canónica distinta de la propia página (consolidación de contenido
   * canibalizado, ver src/lib/canonical-map.ts). Cuando llega, el
   * <link rel="canonical"> apunta ahí en vez de a la propia URL.
   */
  canonicalPath?: string;
  /** Imagen OG absoluta o ruta en /public */
  image?: string;
  /** Tipo Open Graph */
  ogType?: 'website' | 'article';
  /** Evita indexación */
  noindex?: boolean;
}

const {
  title,
  description,
  path,
  canonicalPath,
  image = SITE.defaultOgImage,
  ogType = 'website',
  noindex = false,
} = Astro.props;

// Canonical robusto: usa Astro.url contra el site configurado.
//
// Una sola forma canónica en todo el sitio: SIN barra final, exactamente la
// misma cadena que publica el sitemap y que usan los enlaces internos. Antes la
// home canonizaba a ".../" y el sitemap la anunciaba sin barra: una diferencia
// pequeña, pero es justo el tipo de señal contradictoria que disparó las 78
// "páginas huérfanas" de la auditoría.
const canonicalURL = new URL(
  canonicalPath ?? path ?? Astro.url.pathname,
  Astro.site ?? SITE.url,
);
// El objeto URL vuelve a poner la barra de la raíz al serializar, así que la
// forma final se compone como cadena.
const canonicalHref = canonicalURL.toString().replace(/\/$/, '');
const ogImageURL = new URL(image, Astro.site ?? SITE.url);

// Título completo.
//
// El sufijo de marca ocupa 26 caracteres y se añadía siempre, lo que dejaba
// todos los artículos entre 89 y 114 caracteres: muy por encima de lo que
// muestra Google, que acababa reescribiendo el title por su cuenta. Ahora solo
// se añade si el resultado cabe en MAX_TITLE; si no, gana el título.
const MAX_TITLE = 60;
const sufijo = ` | ${SITE.name}`;
const fullTitle =
  title === SITE.name || title.length + sufijo.length > MAX_TITLE
    ? title
    : `${title}${sufijo}`;
---

<!-- Generales -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />

<!--
  Google Consent Mode v2 — estado por defecto DENEGADO.
  Debe ejecutarse ANTES de cargar cualquier tag de Google. Reaplica el
  consentimiento previo del usuario (cookie) para evitar parpadeos y
  respetar su elección en visitas recurrentes.
-->
<script is:inline define:vars={{ cookieName: COOKIE_CONSENT.cookieName, version: COOKIE_CONSENT.version }}>
  window.dataLayer = window.dataLayer || [];
  function gtag() {
    dataLayer.push(arguments);
  }
  window.gtag = gtag;

  gtag('consent', 'default', {
    ad_storage: 'denied',
    ad_user_data: 'denied',
    ad_personalization: 'denied',
    analytics_storage: 'denied',
    functionality_storage: 'denied',
    personalization_storage: 'denied',
    security_storage: 'granted',
    wait_for_update: 500,
  });

  try {
    var match = document.cookie.match(
      new RegExp('(?:^|;\\s*)' + cookieName + '=([^;]+)')
    );
    if (match) {
      var stored = JSON.parse(decodeURIComponent(match[1]));
      if (stored && stored.v === version && stored.categories) {
        var c = stored.categories;
        gtag('consent', 'update', {
          ad_storage: c.marketing ? 'granted' : 'denied',
          ad_user_data: c.marketing ? 'granted' : 'denied',
          ad_personalization: c.marketing ? 'granted' : 'denied',
          analytics_storage: c.analytics ? 'granted' : 'denied',
          functionality_storage: c.preferences ? 'granted' : 'denied',
          personalization_storage: c.preferences ? 'granted' : 'denied',
        });
      }
    }
  } catch (e) {
    /* cookie ilegible: se mantiene el estado denegado por defecto */
  }
</script>
{
  GA_MEASUREMENT_ID && (
    <>
      <script
        is:inline
        async
        src={`https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}`}
      />
      <script is:inline define:vars={{ id: GA_MEASUREMENT_ID }}>
        gtag('js', new Date());
        gtag('config', id, { anonymize_ip: true });
      </script>
    </>
  )
}
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="sitemap" href="/sitemap-index.xml" />

<!-- SEO primario -->
<title>{fullTitle}</title>
<meta name="title" content={fullTitle} />
<meta name="description" content={description} />
<meta name="author" content={SITE.author} />
<link rel="canonical" href={canonicalHref} />
{noindex && <meta name="robots" content="noindex, nofollow" />}

<!-- Open Graph -->
<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:locale" content={SITE.locale} />
<meta property="og:url" content={canonicalHref} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImageURL} />
{
  image === SITE.defaultOgImage && (
    <>
      <meta property="og:image:width" content={String(SITE.ogImageWidth)} />
      <meta property="og:image:height" content={String(SITE.ogImageHeight)} />
      <meta property="og:image:type" content="image/png" />
    </>
  )
}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalHref} />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageURL} />

<!-- Tipografía -->
<!--
  Tipografías autoalojadas (ver src/styles/global.css). Ya no hay hoja de
  estilos de terceros bloqueando el render en el <head>. Se precargan los dos
  subconjuntos latinos, que son los que necesita cualquier página del sitio.
-->
<link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
<link rel="preload" href="/fonts/fraunces-latin.woff2" as="font" type="font/woff2" crossorigin />
